OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=

# File Paths
LOG_DIR_GLOB=/var/log/nginx/saren/wtako.net/*.log
CONFIG_FILE=log_monitor_config.json
DB_FILE=blacklist.db
NGINX_DENY_LIST=/etc/nginx/conf.d/blacklist.conf
UNBAN_FILE=/tmp/nginx-unban-ips.txt

# Telegram Topic IDs
TOPIC_ID_SUMMARIES=5
TOPIC_ID_BANS_REVIEWS=3

# LLM Configuration
API_BASE_URL=http://100.64.0.8:8000/v1
LLM_MODEL=gpt-oss-120b
LLM_REVIEW_MODEL=gpt-oss-120b

# Monitor Parameters
MAX_QUEUE_SIZE=100
MAX_WAIT_SECONDS=60
POLLING_INTERVAL_SECONDS=5

# Reviewer Parameters
REVIEW_INTERVAL_SECONDS=60
SUMMARY_INTERVAL_SECONDS=43200